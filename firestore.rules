rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net default catch-all (deny by default)
    match /{document=**} {
      allow read, write: if false;
    }

    // Reuseable global helpers for access control
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Users Schema Validation
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 200 &&
             data.role is string && (data.role == 'customer' || data.role == 'admin') &&
             data.companyName is string && data.companyName.size() <= 300 &&
             data.createdAt is string;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      // Prevent self-assigned admin privilege escalation
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.role == 'customer';
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    // 2. Quotation / RFP Schema Validation
    function isValidQuotation(data) {
      return data.quotationId is string && data.quotationId.size() <= 128 &&
             data.companyName is string && data.companyName.size() <= 300 &&
             data.contactPerson is string && data.contactPerson.size() <= 200 &&
             data.phone is string && data.phone.size() <= 50 &&
             data.email is string && data.email.size() <= 200 &&
             data.productType is string && data.productType.size() <= 100 &&
             data.quantity is int && data.quantity >= 1 &&
             data.status is string && (data.status == 'New' || data.status == 'Quote Generated' || data.status == 'Pending Approval' || data.status == 'Converted' || data.status == 'Lost') &&
             data.createdAt is string;
    }

    match /quotations/{quotationId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow list: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      
      // Permit creation by any authenticated user for their own email, or by administrator
      allow create: if (isSignedIn() && isValidQuotation(request.resource.data) && request.resource.data.email == request.auth.token.email) || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 3. Platform Admins Table
    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
