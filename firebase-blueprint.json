{
  "entities": {
    "users": {
      "title": "User Profile Collection",
      "description": "Enterprise-grade B2B platform user registrations holding roles and corporate information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique Firebase Auth identifier for the user" },
        "name": { "type": "string", "description": "User's contact display name" },
        "email": { "type": "string", "description": "Verified B2B email address" },
        "phone": { "type": "string", "description": "Corporate contact mobile number" },
        "role": { "type": "string", "enum": ["customer", "admin"], "description": "Role-Based Access Control parameter" },
        "companyName": { "type": "string", "description": "Affiliated enterprise or B2B enterprise name" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account registration timestamp" }
      },
      "required": ["uid", "name", "email", "role", "companyName", "createdAt"]
    },
    "quotations": {
      "title": "B2B Quotation Requests",
      "description": "Quotation RFPs issued by users or generated by administrators for pricing estimates.",
      "type": "object",
      "properties": {
        "quotationId": { "type": "string", "description": "The unique quotation or RFP identifier" },
        "companyName": { "type": "string", "description": "B2B client enterprise name" },
        "contactPerson": { "type": "string", "description": "Enterprise lead coordinator" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "email": { "type": "string", "description": "B2B supplier or purchaser verification email" },
        "productType": { "type": "string", "description": "Aesthetic or specifications package category" },
        "quantity": { "type": "integer", "description": "Total corrugated sheets or cases required" },
        "destination": { "type": "string", "description": "Logistical transit delivery address" },
        "notes": { "type": "string", "description": "Optional custom corrugated requirements/specifications" },
        "status": { "type": "string", "enum": ["New", "Quote Generated", "Pending Approval", "Converted", "Lost"], "description": "Fulfillment status in pipeline" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Date-time request was placed" }
      },
      "required": ["quotationId", "companyName", "contactPerson", "phone", "email", "productType", "quantity", "status", "createdAt"]
    },
    "admins": {
      "title": "B2B Platform Authorities",
      "description": "Administrators verified to access supply ledgers and issue estimates.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Authorized staff Firebase authentication ID" },
        "email": { "type": "string", "description": "Staff primary communication email" },
        "role": { "type": "string", "enum": ["admin"], "description": "Fixed administrative designation" },
        "permissions": { "type": "array", "description": "Access levels assigned to the operator" }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "Individual B2B user registers"
    },
    "/quotations/{quotationId}": {
      "schema": "quotations",
      "description": "Active RFP records ledger"
    },
    "/admins/{adminId}": {
      "schema": "admins",
      "description": "Staff access permissions maps"
    }
  }
}
